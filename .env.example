# Confluent credentials: inject via environment/secret manager, never commit this file with values.
CONFLUENT_CLOUD_API_KEY=
CONFLUENT_CLOUD_API_SECRET=
CONFLUENT_CLUSTER_ID=
CONFLUENT_REST_ENDPOINT=
SCHEMA_REGISTRY_URL=
SCHEMA_REGISTRY_API_KEY=
SCHEMA_REGISTRY_API_SECRET=

# PostgreSQL managed endpoint reachable from Confluent Cloud connector
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=payments
POSTGRES_USER=cdc_user
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=verify-full
